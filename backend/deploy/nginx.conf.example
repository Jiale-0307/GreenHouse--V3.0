# 放入用户现有HTTPS站点的server块；保留已经部署的前端root与证书配置。
# 浏览器必须访问HTTPS；.env ALLOWED_ORIGINS填写实际前端来源。
location /api/v1/ {
    # 会话与业务响应不得通过代理缓存复用到其他浏览器。
    proxy_cache off;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    client_max_body_size 256k;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 90s;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
location = /index.html {
    add_header Cache-Control "no-store" always;
}
location = /ws {
    proxy_pass http://127.0.0.1:8080/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
}
# 调试期间按需加入；公网开放前可关闭DOCS_ENABLED，或在反向代理限制访问。
location = /docs {
    proxy_pass http://127.0.0.1:8080/docs;
}
location = /openapi.json {
    proxy_pass http://127.0.0.1:8080/openapi.json;
}
