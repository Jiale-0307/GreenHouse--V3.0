# 复制为.env后填写。只供后端读取，禁止放入前端。
APP_ENV=development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zfxzg
DB_USER=zfxzg
DB_PASSWORD=
# 连接远程MySQL使用受信任CA，可填容器内的 /app/config/mysql-ca.pem
DB_SSL_CA=
AUTO_MIGRATE=true
# 精确填写前端来源；同源反代也要填写浏览器看到的完整来源
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_HOURS=12
DOCS_ENABLED=true
# 未知上传周期保持空白；此变量留空时请删除该行，不能把空字符串当数字
# STALE_AFTER_SECONDS=60
COMMAND_TIMEOUT_SECONDS=30
MAX_HISTORY_DAYS=31
MAX_TREND_POINTS=10000
# 运行 python -c 'import secrets; print(secrets.token_urlsafe(32))' 在自己终端生成
INGEST_TOKEN=
ENABLE_DEBUG_CONTROL=false
# 真实控制保持关闭，取得实际下行/回读协议后再配置现场网关
CONTROL_ENABLED=false
CONTROL_PROTOCOL_CONFIRMED=false
CONTROL_GATEWAY_URL=
CONTROL_GATEWAY_TOKEN=
# 通用兼容 chat/completions 的模型服务根路径，例如供应方文档中的 /v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
MQTT_ENABLED=false
MQTT_HOST=
# 端口、TLS、QoS均是软件配置示例，必须按现有Broker确认；未连接现场
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=zfxzg-backend
MQTT_QOS=0
MQTT_MAPPING_FILE=/app/config/mqtt.json
# 原始Modbus透传读取，与上方JSON订阅互相独立。认证仍使用上方MQTT_USERNAME/PASSWORD。
MQTT_MODBUS_ENABLED=false
MQTT_MODBUS_CONFIG_FILE=/app/config/modbus-mqtt.json
